{
	"openapi": "3.0.0",
	"info": {
		"title": "Workorder",
		"description": "OpenAPI spec for Damage Assessment Helper with two endpoints: Create case and upload file to case.",
		"contact": {
			"name": "dod",
			"url": "https://markthuesen.dk/",
			"email": "support@dod.dk"
		},
		"version": "1.0.0"
	},
	"servers": [
		{
			"url": "https://127.0.0.1/-_Mercantec/deploy_or_die/frontend/api/case",
			"description": "API server"
		}
	],
	"tags": [
		{
			"name": "Cases",
			"description": "Case-related endpoints"
		},
		{
			"name": "Files",
			"description": "File upload"
		}
	],
	"security": [
		{
			"AuthBearerToken": []
		}
	],
	"paths": {
		"/insert": {
			"post": {
				"tags": [
					"Cases"
				],
				"summary": "Create a new case",
				"operationId": "createCase",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"required": [
									"insurance_id",
									"plate"
								],
								"type": "object",
								"properties": {
									"plate": {
										"maxLength": 7,
										"type": "string",
										"description": "Plate",
										"example": "AB12345"
									},
									"note": {
										"type": "string",
										"description": "Case note",
										"example": "Bumper scratch"
									},
									"insurance_id": {
										"type": "string",
										"description": "Insurance company id",
										"format": "char",
										"example": "01"
									}
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"description": "Case created successfully.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cases"
								}
							}
						}
					},
					"400": {
						"description": "Input error — validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								},
								"example": {
									"success": false,
									"message": "Validation error.",
									"details": [
										{
											"field": "plate",
											"error": "Exceeded limit of 7 characters"
										}
									]
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/missingAuthorizationError"
					},
					"403": {
						"$ref": "#/components/responses/invalidTokenError"
					},
					"500": {
						"$ref": "#/components/responses/serverError"
					}
				}
			}
		},
		"/upload/{case_id}": {
			"post": {
				"tags": [
					"Files"
				],
				"summary": "Upload a file to a case",
				"operationId": "uploadCaseFile",
				"parameters": [
					{
						"name": "case_id",
						"in": "path",
						"description": "Case id",
						"required": true,
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "filename",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string"
						},
						"description": "Filename"
					}
				],
				"requestBody": {
					"content": {
						"application/octet-stream": {
							"schema": {			
								"required": [
									"file"
								],
								"type": "object",
								"properties": {
									"file": {
										"type": "string",
										"description": "File upload",
										"format": "binary"
									}
								}
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"description": "File uploaded successfully.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Files"
								}
							}
						}
					},
					"400": {
						"description": "Input error — validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								},
								"example": {
									"success": false,
									"message": "Validation error.",
									"details": [
										{
											"field": "case_id",
											"error": "No case with id `1`."
										}
									]
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/missingAuthorizationError"
					},
					"403": {
						"$ref": "#/components/responses/invalidTokenError"
					},
					"500": {
						"$ref": "#/components/responses/serverError"
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"AuthBearerToken": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "Token",
				"description": "JWT Authorization header using the Bearer scheme. Enter your 'Bearer' token in the text input below."
			}
		},
		"responses": {
			"missingAuthorizationError": {
				"description": "Missing 'Authorization' header."
			}, 
			"invalidTokenError": {
				"description": "Wrong token."
			}, 
			"serverError": {
				"description": "An internal server error occurred."
			}
		},
		"schemas": {
			"Cases": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"example": true
					},
					"message": {
						"type": "string",
						"example": "Case created successfully."
					},
					"plate": {
						"type": "string",
						"example": "AB12345"
					},
					"note": {
						"type": "string",
						"example": "Bumper scratch"
					},
					"insurance_id": {
						"type": "string",
						"example": "01"
					},
					"user_id": {
						"type": "integer",
						"example": 1
					},
					"client_id": {
						"type": "integer",
						"example": 1
					}
				}
			},
			"Files": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"example": true
					},
					"message": {
						"type": "string",
						"example": "File uploaded successfully."
					},
					"id": {
						"type": "integer",
						"example": 1
					},
					"case_id": {
						"type": "integer",
						"example": 1
					},
					"name": {
						"type": "string",
						"example": "front_bumper.jpg"
					},
					"mime": {
						"type": "string",
						"example": "image/jpeg"
					}
				}
			},
			"ApiError": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"example": false
					},
					"message": {
						"type": "string",
						"example": "Validation error."
					},
					"details": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"field": {
									"type": "string",
									"example": "plate"
								},
								"error": {
									"type": "string",
									"example": "Exceeded limit of 7 characters"
								}
							}
						}
					}
				}
			}
		}
	}
}
